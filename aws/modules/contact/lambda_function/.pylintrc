[MASTER]
disable=
    C0111, # missing-docstring
    C0103, # invalid-name
    C0301, # line-too-long
    W0621, # redefined-outer-name
    R0903, # too-few-public-methods
    W0702, # bare-except
    W0703, # broad-except

[FORMAT]
max-line-length=120

[MESSAGES CONTROL]
disable=missing-function-docstring,missing-module-docstring,missing-class-docstring
