# Default recipe to run when just is called without arguments
default:
    @just --list

# Setup virtual environment and install dependencies
setup:
    python -m venv ../.venv
    . ../.venv/bin/activate && \
    just install

# Run all tests with coverage report
test:
    pytest . --cov=../lambda_function --cov-report=term-missing

# Run only unit tests
test-unit:
    pytest unit/

# Run only integration tests
test-integration:
    pytest integration/

# Run tests and generate HTML coverage report
test-coverage:
    pytest . --cov=../lambda_function --cov-report=html
    @echo "Coverage report generated in htmlcov/index.html"

# Run tests in watch mode (requires pytest-watch)
test-watch:
    ptw . -- --cov=../lambda_function

# Run tests with verbose output
test-verbose:
    pytest -vv .

# Clean up pytest cache, coverage reports, and python cache files
clean:
    rm -rf .pytest_cache
    rm -rf .coverage
    rm -rf htmlcov
    rm -rf __pycache__
    rm -rf */__pycache__
    rm -rf ../__pycache__

# Activate virtual environment (needs to be run with source)
activate:
    echo "Run 'source ../.venv/bin/activate' to activate the virtual environment"

# Install all requirements
install:
    . ../.venv/bin/activate && \
    pip install -r ../requirements.txt && \
    pip install -r requirements-test.txt && \
    pip install pylint black

# Lint the code
lint: 
    -pylint --rcfile=../.pylintrc ../lambda_function.py ./

# Format the code
format:
    . ../.venv/bin/activate && black ../lambda_function.py ./
